{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opamp.info/signal-generator/schemas/metric-frame-v1.json",
  "title": "SignalGenerator metric frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["metrics"],
  "properties": {
    "frame": {"type": ["integer", "string"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "help", "samples"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$", "not": {"pattern": "^signal_generator_"}},
          "type": {"enum": ["counter", "gauge", "histogram", "summary", "info", "untyped"]},
          "help": {"type": "string"},
          "unit": {"type": "string"},
          "samples": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        }
      }
    }
  }
}
