{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opamp.info/signal-generator/schemas/config-v1.json",
  "title": "SignalGenerator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "runtime": {"$ref": "#/$defs/runtime"},
    "deployment": {"$ref": "#/$defs/deployment"},
    "logs": {"$ref": "#/$defs/logs"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "traces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"const": false, "default": false}}
    }
  },
  "anyOf": [
    {"properties": {"logs": {"required": ["enabled"], "properties": {"enabled": {"const": true}}}}, "required": ["logs"]},
    {"properties": {"metrics": {"required": ["enabled"], "properties": {"enabled": {"const": true}}}}, "required": ["metrics"]}
  ],
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log_level": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"], "default": "DEBUG"},
        "shutdown_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 10},
        "diagnostics": {"type": "boolean", "default": false}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["standalone", "embedded_quart"], "default": "standalone"},
        "failure_policy": {"enum": ["fail_process", "isolate"]},
        "route_prefix": {"type": "string", "pattern": "^/"},
        "runtime_id": {"type": "string", "minLength": 1}
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "source": {"$ref": "#/$defs/log_source"},
        "format": {"type": "string", "minLength": 1, "default": "%t %m"},
        "datetime_format": {"type": "string", "minLength": 1},
        "separator": {"type": "string"},
        "defaults": {"$ref": "#/$defs/log_defaults"},
        "replay": {"$ref": "#/$defs/replay"},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}}
      },
      "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"required": ["source", "outputs"]}}]
    },
    "log_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "datetime_format": {"type": "string", "minLength": 1},
        "separator": {"type": ["string", "null"]},
        "encoding": {"type": "string", "minLength": 1, "default": "utf-8"},
        "unescape_newlines": {"type": "boolean", "default": false},
        "multiline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_line_pattern"],
          "properties": {"first_line_pattern": {"type": "string", "minLength": 1}}
        }
      }
    },
    "log_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "process": {"type": "string"},
        "location": {"type": "string"},
        "log_level": {"type": "string"}
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cycles": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "forever"}], "default": 1},
        "default_interval_ms": {"type": "integer", "minimum": 0, "default": 1000},
        "acceleration": {"type": "number", "exclusiveMinimum": 0, "default": 1},
        "start_delay_ms": {"type": "integer", "minimum": 0, "default": 0},
        "start_at": {"type": "string", "default": "now"},
        "loop_gap_ms": {"type": "integer", "minimum": 0, "default": 0},
        "source_priority": {"type": "integer", "default": 100}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_attempts": {"type": "integer", "minimum": 1, "default": 3},
        "initial_backoff_seconds": {"type": "number", "minimum": 0, "default": 0.1},
        "maximum_backoff_seconds": {"type": "number", "minimum": 0, "default": 30}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["stdout", "stderr", "file", "http", "tcp", "python_logging", "plugin"]},
        "failure_policy": {"enum": ["fail", "retry", "continue"], "default": "fail"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 5},
        "retry": {"$ref": "#/$defs/retry"},
        "path": {"type": "string", "minLength": 1},
        "mode": {"enum": ["append", "overwrite"], "default": "append"},
        "flush_each_event": {"type": "boolean", "default": true},
        "url": {"type": "string", "format": "uri"},
        "method": {"enum": ["POST", "PUT"], "default": "POST"},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "content_type": {"type": "string", "default": "text/plain; charset=utf-8"},
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "connect_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "delimiter": {"type": "string", "default": "\n"},
        "logger_name": {"type": "string", "default": "signal_generator.replay"},
        "level": {"type": "string", "default": "INFO"},
        "plugin_name": {"type": "string", "minLength": 1},
        "options": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "file"}}}, "then": {"required": ["path"]}},
        {"if": {"properties": {"type": {"const": "http"}}}, "then": {"required": ["url"]}},
        {"if": {"properties": {"type": {"const": "tcp"}}}, "then": {"required": ["host", "port"]}},
        {"if": {"properties": {"type": {"const": "plugin"}}}, "then": {"required": ["plugin_name"]}}
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "encoding": {"type": "string", "default": "utf-8"},
            "eof": {"enum": ["loop", "hold_last", "stop", "error"], "default": "loop"},
            "maximum_line_bytes": {"type": "integer", "minimum": 1, "default": 10485760},
            "maximum_samples_per_frame": {"type": "integer", "minimum": 1, "default": 100000}
          }
        },
        "pull": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "host": {"type": "string", "minLength": 1, "default": "127.0.0.1"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 9108},
            "path": {"type": "string", "pattern": "^/", "default": "/metrics"},
            "include_self_metrics": {"type": "boolean", "default": true}
          }
        },
        "push": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "protocol": {"const": "pushgateway", "default": "pushgateway"},
            "url": {"type": "string", "format": "uri"},
            "job": {"type": "string", "minLength": 1},
            "grouping_key": {
              "type": "object",
              "propertyNames": {"pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
              "additionalProperties": {"type": "string"},
              "default": {}
            },
            "interval_seconds": {"type": "number", "exclusiveMinimum": 0},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 5},
            "method": {"const": "replace", "default": "replace"},
            "basic_auth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["username", "password_env"],
              "properties": {
                "username": {"type": "string", "minLength": 1},
                "password_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
              }
            },
            "bearer_token_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "verify": {"type": "boolean", "default": true},
                "ca_file": {"type": "string", "minLength": 1}
              }
            },
            "retry": {"$ref": "#/$defs/retry"},
            "use_source_timing": {"type": "boolean", "default": false}
          },
          "allOf": [
            {
              "if": {"properties": {"enabled": {"const": true}}},
              "then": {"required": ["url", "job", "interval_seconds"]}
            },
            {
              "not": {"required": ["basic_auth", "bearer_token_env"]}
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {
            "required": ["source"],
            "anyOf": [
              {"properties": {"pull": {"required": ["enabled"], "properties": {"enabled": {"const": true}}}}, "required": ["pull"]},
              {"properties": {"push": {"required": ["enabled"], "properties": {"enabled": {"const": true}}}}, "required": ["push"]}
            ]
          }
        }
      ]
    }
  }
}
