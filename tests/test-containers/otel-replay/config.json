{
  "schema_version": 1,
  "metrics": {
    "enabled": true,
    "source": {"path": "metrics.ndjson", "eof": "loop"},
    "push": {
      "enabled": true,
      "protocol": "otlp_http_json",
      "url": "http://otel-receiver:4318/v1/metrics",
      "interval_seconds": 0.1,
      "timeout_seconds": 2
    }
  },
  "traces": {
    "enabled": true,
    "source": {"path": "traces.ndjson"},
    "replay": {"cycles": 2, "acceleration": 10, "loop_gap_ms": 10},
    "push": {
      "protocol": "otlp_http_json",
      "url": "http://otel-receiver:4318/v1/traces",
      "timeout_seconds": 2
    }
  }
}

